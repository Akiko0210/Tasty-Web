# Tastyworks API credentials
TASTYWORKS_ACCOUNT_ID=
REFRESH_TOKEN=
CLIENT_SECRET=
TASTY_BASE_URL=https://api.tastyworks.com
TASTYTRADE_TOKEN=

# Set to True to use Tastyworks sandbox/cert environment instead of production
# TASTYTRADE_IS_TEST=True

# Anthropic API key for the LLM voice agent (required for /api/voice-agent)
ANTHROPIC_API_KEY=

# Optional model override (defaults to claude-opus-4-8)
ANTHROPIC_VOICE_MODEL=claude-haiku-4-5
